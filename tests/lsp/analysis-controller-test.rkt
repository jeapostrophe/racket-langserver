  (test-case "arbitrary raise, premature death and timeout settle shared waiters and permit retry"
    (define probes (make-async-channel))
    (with-session (make-source-controller #:analyze (controlled-analyzer probes)
                                          #:analysis-timeout 0.3)
                  (lambda (session)
                    (define path (build-path scratch "failed-analysis.rkt"))
                    (open! session path text)
                    (define initial (await probes))
                    (barrier session)
                    (define first (acquire session path))
                    (request session "textDocument/inlayHint" 14 path)
                    (request session "textDocument/semanticTokens/full" 15 path)
                    (barrier session)
                    (release-gate! initial 'raise)
                    (check-equal? (await first) (Analysis-Outcome 'failed 'arbitrary-analysis-failure))
                    (check-error (response session 14) ErrorCode-RequestFailed)
                    (check-error (response session 15) ErrorCode-RequestFailed)
                    (define dead (acquire session path))
                    (request session "textDocument/inlayHint" 16 path)
                    (barrier session)
                    (release-gate! (await probes) 'die)
                    (check-equal? (await dead) (Analysis-Outcome 'failed 'worker-exited))
                    (check-error (response session 16) ErrorCode-RequestFailed)
                    (define timed-out (acquire session path))
                    (await probes)
                    (define peer (acquire session path))
                    (request session "textDocument/semanticTokens/full" 17 path)
                    (check-equal? (await timed-out) (Analysis-Outcome 'failed 'analysis-timeout))
                    (check-error (response session 17) ErrorCode-RequestFailed)
                    (check-eq? (await timed-out) (await peer))
                    (check-equal? (notifications session) '())
                    (close! session path)
                    (barrier session))))

  (test-case "expansion custodian shutdown settles waiters and releases the last slot"
    (define probes (make-async-channel))
    (with-session (make-source-controller #:analyze (controlled-analyzer probes)
                                          #:analysis-slots 1
                                          #:analysis-timeout 1
                                          #:resyntax #f)
                  (lambda (session)
                    (define a (build-path scratch "custodian-shutdown.rkt"))
                    (define b (build-path scratch "after-custodian-shutdown.rkt"))
                    (open! session a
                           (string-append "#lang racket/base\n"
                                          "(require (for-syntax racket/base))\n"
                                          "(begin-for-syntax\n"
                                          "  (custodian-shutdown-all (current-custodian)))\n"))
                    (define first-probe (await probes))
                    (open! session b text)
                    (barrier session)
                    (define first (acquire session a))
                    (define peer (acquire session a))
                    (define queued (acquire session b))
                    (request session "textDocument/inlayHint" 18 a)
                    (barrier session)
                    (check-false (sync/timeout 0 probes))
                    (release-gate! first-probe)
                    (define outcome (await first))
                    ;; Worker death and the deadline can be ready together.
                    (check-eq? 'failed (Analysis-Outcome-state outcome))
                    (check-not-false (memq (Analysis-Outcome-value outcome)
                                           '(worker-exited analysis-timeout)))
                    (check-eq? (await first) (await peer))
                    (check-error (response session 18) ErrorCode-RequestFailed)
                    (define next-probe (await probes))
                    (check-equal? (Source-Snapshot-id (Gate-input next-probe))
                                  (source-id (path->source b)))
                    (release-gate! next-probe)
                    (check-eq? 'succeeded (Analysis-Outcome-state (await queued)))
                    (close! session a)
                    (close! session b)
                    (barrier session))))

